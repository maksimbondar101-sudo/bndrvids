# Mirrors the [[headers]] blocks in netlify.toml.
#
# Both exist on purpose. netlify.toml is authoritative for Git-based builds and
# is the file to edit; this one covers manual and drag-and-drop deploys, where
# _headers is guaranteed to be read. Where both apply, netlify.toml wins and the
# rules are identical anyway. Change one, change the other.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cal.com https://app.cal.com; media-src 'self'; object-src 'none'; connect-src 'self' https://app.cal.com https://api.cal.com; frame-src https://cal.com https://app.cal.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

# Fonts are content-addressed by filename, so a year of immutable caching can
# never strand anyone on a stale one. Nothing else here is versioned that way.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
